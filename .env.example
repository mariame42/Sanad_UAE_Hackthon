# LLM provider (OpenAI-compatible or similar)
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Check-in camera focus tracking: "live" (webcam + on-device model, default)
# or "mock" (scripted demo camera for presentations: no webcam, no internet).
NEXT_PUBLIC_FOCUS_CAMERA=live
